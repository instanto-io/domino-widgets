<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>domino-widgets-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>domino-build-verification</artifactId>
  <packaging>pom</packaging>
  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>domino-build-inputs</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>domino-widgets-bom</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>domino-widgets-assets</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>binding-generator</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>teavm-jsinterop-compat</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>teavm-elemental2-compat</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>teavm-gwt-modular-services</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>domino-widgets-teavm</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>showcase-teavm</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>compat-reuse-smoke</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>domino-build-maven-plugin</artifactId>
        <version>${project.version}</version>
        <configuration>
          <rootDirectory>${project.basedir}/..</rootDirectory>
        </configuration>
        <executions>
          <execution>
            <id>verify-build</id>
            <phase>verify</phase>
            <goals>
              <goal>analysis</goal>
              <goal>check-artifacts</goal>
              <goal>member-inventory</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>pages</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>pages</id>
                <phase>verify</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.basedir}/../target/pages</outputDirectory>
                  <resources>
                    <resource>
                      <directory>src/pages</directory>
                      <filtering>false</filtering>
                    </resource>
                    <resource>
                      <directory>../showcase-teavm/target/site</directory>
                      <filtering>false</filtering>
                      <targetPath>teavm</targetPath>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
