<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>domino-widgets-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>domino-history-teavm</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.dominokit</groupId>
      <artifactId>domino-history-shared</artifactId>
      <version>1.0.6</version>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>elemental2-compat</artifactId>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.18.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>../target/compat/history</sourceDirectory>
    <testSourceDirectory>../target/intake/history/tests</testSourceDirectory>
    <testResources>
      <testResource>
        <directory>../target/intake/history/test-resources</directory>
      </testResource>
    </testResources>
    <resources>
      <resource>
        <directory>../target/intake/history/licenses</directory>
        <targetPath>META-INF</targetPath>
      </resource>
      <resource>
        <directory>..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>upstream/libraries-lock.json</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <implicit>none</implicit>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>io.instanto</groupId>
            <artifactId>binding-generator</artifactId>
            <version>${project.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>backend-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.google.elemental2:*</exclude>
                    <exclude>com.google.jsinterop:base</exclude>
                    <exclude>org.gwtproject:gwt-user</exclude>
                    <exclude>io.instanto:domino-widgets-teavm</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
