<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>domino-widgets-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>domino-build-inputs</artifactId>
  <packaging>pom</packaging>
  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>domino-build-maven-plugin</artifactId>
        <version>${project.version}</version>
        <configuration>
          <rootDirectory>${project.basedir}/..</rootDirectory>
        </configuration>
        <executions>
          <execution>
            <id>verify-and-prepare-inputs</id>
            <phase>initialize</phase>
            <goals>
              <goal>intake</goal>
            </goals>
          </execution>
          <execution>
            <id>verify-showcase-adapters</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>showcase</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
