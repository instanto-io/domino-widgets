<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>domino-widgets-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>domino-browser-tests</artifactId>
  <packaging>pom</packaging>
  <modules>
    <module>teavm</module>
    <module>webkit</module>
    <module>platform-checks</module>
  </modules>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <cucumber-tea.version>0.1.0-SNAPSHOT</cucumber-tea.version>
    <mockatcha.version>0.1.0-SNAPSHOT</mockatcha.version>
    <webapp-testkit.version>0.1.0-SNAPSHOT</webapp-testkit.version>
    <teavm.junit.js.runner>browser-chrome</teavm.junit.js.runner>
    <browser.engine>chrome</browser.engine>
    <domino.build.root>${project.basedir}/../..</domino.build.root>
    <domino.external.root>${domino.build.root}/examples</domino.external.root>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
  <repositories>
    <repository>
      <id>github-cucumber-tea</id>
      <url>https://maven.pkg.github.com/cstainton/cucumber-tea</url>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>github-mockatcha</id>
      <url>https://maven.pkg.github.com/instanto-io/mockatcha</url>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>github-gherkin-tea</id>
      <url>https://maven.pkg.github.com/cstainton/gherkin-tea</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>webapp-testkit-app</artifactId>
      <version>${webapp-testkit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>cucumber-tea</artifactId>
      <version>${cucumber-tea.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>cucumber-tea-codegen</artifactId>
      <version>${cucumber-tea.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-junit</artifactId>
      <version>${teavm.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <testResources>
      <testResource>
        <directory>${project.basedir}/../common/src/test/resources</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>shared-tests</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../common/src/test/java</source>
                <source>${project.basedir}/../common/src/host/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <release>21</release>
        </configuration>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <proc>full</proc>
              <annotationProcessors>
                <annotationProcessor>io.instanto.cucumber.tea.codegen.CucumberTeaProcessor</annotationProcessor>
              </annotationProcessors>
              <compilerArgs>
                <arg>-Acucumber.tea.runner=teavm</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
          <reportsDirectory>${project.build.directory}/surefire-reports-${browser.engine}</reportsDirectory>
          <includes>
            <include>**/*StepsTest.java</include>
          </includes>
          <excludes>
            <exclude>**/ExternalStepsTest.java</exclude>
          </excludes>
          <systemPropertyVariables>
            <domino.build.root>${domino.build.root}</domino.build.root>
            <domino.external.root>${domino.external.root}</domino.external.root>
            <domino.test.resources>${project.build.testOutputDirectory}</domino.test.resources>
            <teavm.junit.target>${project.build.directory}/teavm-tests</teavm.junit.target>
            <teavm.junit.js.runner>${teavm.junit.js.runner}</teavm.junit.js.runner>
            <teavm.junit.js.decodeStack>true</teavm.junit.js.decodeStack>
            <teavm.junit.js>true</teavm.junit.js>
            <teavm.junit.wasm>false</teavm.junit.wasm>
            <teavm.junit.wasm-gc>false</teavm.junit.wasm-gc>
            <user.language>en</user.language>
            <user.country>US</user.country>
            <user.timezone>UTC</user.timezone>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
