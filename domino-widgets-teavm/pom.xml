<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>domino-widgets-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>domino-widgets-teavm</artifactId>
  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>gwt-modular-services-compat</artifactId>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>elemental2-compat</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.30</version>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
          <include>upstream/source-lock.json</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>backend-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.google.elemental2:*</exclude>
                    <exclude>com.google.jsinterop:base</exclude>
                    <exclude>io.instanto:domino-widgets-gwt</exclude>
                    <exclude>io.instanto:verrai-*</exclude>
                    <exclude>io.instanto:sarto-*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <implicit>none</implicit>
          <excludes>
            <exclude>org/gwtproject/**</exclude>
          </excludes>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>io.instanto</groupId>
            <artifactId>binding-generator</artifactId>
            <version>${project.version}</version>
            <type>jar</type>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>inspect-compat-artifacts</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeGroupIds>io.instanto</includeGroupIds>
              <outputDirectory>${project.build.directory}/compat-dependencies</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <sourceDirectory>../target/compat/domino</sourceDirectory>
  </build>
</project>
