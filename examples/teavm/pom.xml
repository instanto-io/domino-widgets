<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>example</groupId>
    <artifactId>domino-consumers</artifactId>
    <version>1.0</version>
  </parent>
  <artifactId>consumer-teavm</artifactId>
  <properties>
    <instanto.terser.phase>prepare-package</instanto.terser.phase>
    <instanto.terser.directory>${project.build.directory}/site</instanto.terser.directory>
    <instanto.terser.file>app.js</instanto.terser.file>
    <instanto.terser.version>5.51.2</instanto.terser.version>
    <instanto.terser.executable>npx</instanto.terser.executable>
    <instanto.terser.skip>false</instanto.terser.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>domino-widgets-teavm</artifactId>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>domino-widgets-assets</artifactId>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>0.16.0</version>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>domino-slf4j-teavm</artifactId>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/java</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>0.16.0</version>
        <executions>
          <execution>
            <phase>prepare-package</phase>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>example.client.Launcher</mainClass>
          <targetDirectory>${project.build.directory}/site</targetDirectory>
          <targetFileName>app.js</targetFileName>
          <optimizationLevel>ADVANCED</optimizationLevel>
          <minifying>false</minifying>
          <sourceMapsGenerated>true</sourceMapsGenerated>
          <sourceFilesCopied>true</sourceFilesCopied>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>io.instanto</groupId>
            <artifactId>domino-slf4j-teavm</artifactId>
            <version>${domino.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>minify-teavm-js</id>
            <phase>${instanto.terser.phase}</phase>
            <goals><goal>exec</goal></goals>
            <configuration combine.self="override">
              <skip>${instanto.terser.skip}</skip>
              <executable>${instanto.terser.executable}</executable>
              <workingDirectory>${instanto.terser.directory}</workingDirectory>
              <arguments>
                <argument>--yes</argument>
                <argument>--package=terser@${instanto.terser.version}</argument>
                <argument>--</argument>
                <argument>terser</argument>
                <argument>${instanto.terser.file}</argument>
                <argument>--compress</argument>
                <argument>--mangle</argument>
                <argument>--source-map</argument>
                <argument>content='${instanto.terser.file}.map',url='${instanto.terser.file}.map'</argument>
                <argument>--output</argument>
                <argument>${instanto.terser.file}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>consumer-site</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/site</outputDirectory>
              <resources>
                <resource>
                  <directory>src/site</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
